{% comment %}ponytail: duplicated 6-line style block, move to site.css if a third form appears{% endcomment %}
{% style %}
.form-ok,.form-err{font-family:var(--font-mono);font-size:13px;margin:0 0 20px}
.form-ok{color:var(--ink-2)}
.form-err{color:var(--accent)}
{% endstyle %}
  <section class="page-hero" aria-labelledby="sv-h">
    <div class="container reveal">
      <span class="eyebrow">Services</span>
      <h1 id="sv-h">Total solutions for light and furnishings.</h1>
      <p>From the first fixture to the last curtain, one team covers lighting, curtains and blinds, electrical work and renovation, for corporate and individual projects.</p>
    </div>
  </section>

  <section class="section" aria-label="Our services">
    <div class="container sv"><article class="sv-row" id="lighting"><div class="sv-img"><img src="{{ 'service-lighting.jpg' | asset_url }}" width="1200" height="500" alt="Lighting" loading="lazy"></div><div class="sv-text"><span class="mono num">01</span><h2>Lighting</h2><p>Indoor and outdoor lighting from a full range of European and Chinese products, for commercial and residential spaces. The showroom also holds the Swarovski Lighting concept store.</p></div></article><article class="sv-row" id="curtains-blinds"><div class="sv-img"><img src="{{ 'service-curtains.jpg' | asset_url }}" width="500" height="500" alt="Curtains &amp; Blinds" loading="lazy"></div><div class="sv-text"><span class="mono num">02</span><h2>Curtains &amp; Blinds</h2><p>Made-to-order curtains and blinds, with solar films, wall coverings, upholstery, Ziptrak, fabrics and window accessories. Offered since 2011.</p><ol class="sv-steps"><li><span class="mono">01</span>Choose your curtain type and fabric.</li><li><span class="mono">02</span>We visit your home to measure and give you a quote.</li><li><span class="mono">03</span>Confirm your order.</li><li><span class="mono">04</span>We deliver and install.</li></ol><a class="btn btn-primary" href="https://wa.me/6589931008?text=Hi%20Light%20%2B%20Form%2C%20I%27d%20like%20to%20book%20a%20consultation%20with%20your%20curtain%20specialist." rel="noopener">Book a consultation with our curtain specialist</a></div></article><article class="sv-row" id="electrical"><div class="sv-img"><img src="{{ 'service-electrical.jpg' | asset_url }}" width="500" height="500" alt="Electrical Work" loading="lazy"></div><div class="sv-text"><span class="mono num">03</span><h2>Electrical Work</h2><p>Electrical work to support the lighting we supply, backed by a dedicated team for installation and re-wiring.</p></div></article><article class="sv-row" id="renovation"><div class="sv-img"><img src="{{ 'service-renovation.png' | asset_url }}" width="1483" height="742" alt="Renovation Work" loading="lazy"></div><div class="sv-text"><span class="mono num">04</span><h2>Renovation Work</h2><p>Renovation and refurbishment for caf&eacute;s, offices, houses and apartments, drawing on years of project work with developers, architects and interior designers.</p></div></article></div>
  </section>

  <section class="section band" aria-labelledby="as-h">
    <div class="container after reveal">
      <span class="eyebrow">After-sales</span>
      <h2 id="as-h" style="margin-bottom:24px">Support after the sale.</h2>
      <p>A dedicated support team looks after installation, re-wiring, custom fabrication, maintenance and cleaning.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="cons-h" id="consultation">
    <div class="container form-wrap">
      <div class="sec-head reveal"><span class="eyebrow">Consultation</span><h2 id="cons-h">Tell us about your project.</h2></div>
      {% form 'contact', class: 'reveal' %}
        {% if form.posted_successfully? %}<p class="form-ok" role="status">Thanks &mdash; we&rsquo;ll get back to you within a working day.</p>{% endif %}{% if form.errors %}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{% endif %}

        <div class="f-grid">
          <label class="f-row"><span class="mono">Name</span><input type="text" name="contact[name]" autocomplete="name"></label>
          <label class="f-row"><span class="mono">Email</span><input type="email" name="contact[email]" required autocomplete="email"></label>
          <label class="f-row"><span class="mono">Phone</span><input type="tel" name="contact[phone]" autocomplete="tel"></label>
          <label class="f-row"><span class="mono">Company</span><input type="text" name="contact[company]" autocomplete="organization"></label>
          <label class="f-row"><span class="mono">Type of service</span><select name="contact[service]"><option>Lighting</option><option>Curtains &amp; Blinds</option><option>Electrical Work</option></select></label>
          <label class="f-row"><span class="mono">Type of project</span><select name="contact[project]"><option>Corporate</option><option>Individual</option></select></label>
          <label class="f-row wide"><span class="mono">Details</span><textarea name="contact[body]" required rows="4"></textarea></label>
        </div>
        <div class="f-act"><button class="btn btn-primary" type="submit">Request a consultation</button></div>
      {% endform %}
    </div>
  </section>
