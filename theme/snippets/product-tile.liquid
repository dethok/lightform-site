{% doc %}
  @param {product} product
  @param {number} delay - reveal stagger in seconds
{% enddoc %}
{%- assign ip = '' -%}{%- assign ip_text = product.description | strip_html | replace: ' ', ' ' | replace: 'IP ', 'IP' -%}{%- assign ip_codes = 'IP68,IP67,IP66,IP65,IP64,IP55,IP54,IP44,IP43,IP33,IP20' | split: ',' -%}{%- for code in ip_codes -%}{%- if ip_text contains code -%}{%- assign ip = code -%}{%- break -%}{%- endif -%}{%- endfor -%}
<a class="tile reveal" style="--d:{{ delay }}s" href="{{ product.url }}"><div class="lamp" style="--lx:50%;--ly:42%">{% if ip != blank %}<span class="ip-badge mono" title="Ingress protection rating">{{ ip }}</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span class="ph">photo to come</span>{% endif %}</div><div class="tile-row"><div class="tile-id"><h3 class="tile-name">{{ product.title }}</h3><span class="mono">{{ product.type | default: product.vendor }}</span></div><span class="tile-price">{% if product.price_min == 0 %}Contact us{% else %}{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}{% endif %}</span></div></a>
