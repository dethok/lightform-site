<section class="page-head"><div class="container reveal"><h1>{{ blog.title }}.</h1></div></section>
<section class="section"><div class="container rte">
{% paginate blog.articles by 5 %}
  {% for article in blog.articles %}
    <article>
      {% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: article.title }}{% endif %}
      <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
      <p class="mono">{{ article.published_at | time_tag: format: 'date' }}</p>
      <p>{{ article.excerpt_or_content | strip_html | truncate: 200 }}</p>
    </article>
  {% else %}
    <p class="ph">No articles yet.</p>
  {% endfor %}
  {% if paginate.pages > 1 %}<nav class="mono">{{ paginate | default_pagination }}</nav>{% endif %}
{% endpaginate %}
</div></section>

{% schema %}
{"name": "Blog", "settings": []}
{% endschema %}
