{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign images = product.media | where: 'media_type', 'image' -%}
{%- assign models = product.media | where: 'media_type', 'model' -%}
<div class="container">
  <div class="pdp">
    <div class="pdp-gallery">
      {% for media in product.media %}{% case media.media_type %}{% when 'image' %}<div class="lamp g-slide{% if forloop.first %} is-active{% endif %}" style="--lx:50%;--ly:42%">{{ media | image_url: width: 1000 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}</div>{% when 'model' %}<div class="g-slide g-slide-model{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">{{ media | media_tag: image_size: '1000x' }}</div>{% endcase %}
      {% else %}<div class="lamp g-slide is-active" style="--lx:50%;--ly:42%"><span class="ph">product photo to come</span></div>
      {% endfor %}
      {% if images.size > 0 or models.size > 0 %}
        <div class="g-bar">
          {% if models.size > 0 %}<button class="btn btn-ghost btn-sm" type="button" data-shopify-xr data-shopify-model3d-id="{{ models.first.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden>View in your room</button>{% endif %}
          <div class="g-thumbs">
            {% for media in product.media %}{% case media.media_type %}{% when 'image' %}<button type="button" data-thumb aria-label="View image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">{{ media | image_url: width: 112 | image_tag: loading: 'lazy', alt: '' }}</button>{% when 'model' %}<button type="button" data-thumb class="thumb-3d" aria-label="View 3D model" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 112 | image_tag: loading: 'lazy', alt: '' }}<span class="mono">3D</span></button>{% endcase %}{% endfor %}
          </div>
        </div>
        {% if models.size > 0 %}
          <script type="application/json" id="ProductJSON-{{ product.id }}">{{ models | json }}</script>
          <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
          <script src="{{ 'product-model.js' | asset_url }}" defer></script>
        {% endif %}
      {% endif %}
    </div>
    <div class="pdp-buy">
      <span class="eyebrow">{{ product.type | default: product.vendor }}</span>
      <h1>{{ product.title }}</h1>
      {% comment %}ponytail: Megan's descriptions are "<strong>Label:</strong> value" runs (320/332 products). Split on <strong>; "Description" becomes the prose, every other label a spec row. No <strong> at all → raw description, no table.{% endcomment %}
      {%- assign parts = product.description | replace: '&nbsp;', ' ' | replace: ' ', ' ' | split: '<strong' -%}
      {%- assign lead = parts[0] | strip_html | strip -%}
      {%- assign desc_text = '' -%}
      {%- capture spec_rows -%}{%- for part in parts offset: 1 -%}{%- assign kv = part | split: '</strong>' -%}{%- assign label = kv[0] | remove_first: '>' | strip_html | strip_newlines | strip | remove: ':' | strip | replace: 'Color', 'Colour' -%}{%- assign value = kv[1] | strip_html | strip_newlines | strip -%}{%- assign first = value | slice: 0 -%}{%- if first == ':' -%}{%- assign value = value | remove_first: ':' | strip -%}{%- endif -%}{%- if label == 'Description' -%}{%- assign desc_text = value -%}{%- elsif label != blank and value != blank -%}<tr><th scope="row">{{ label }}</th><td>{{ value }}</td></tr>{%- endif -%}{%- endfor -%}{%- endcapture -%}
      {%- assign spec_rows = spec_rows | strip -%}
      {% comment %}ponytail: IP rating lives in the prose ("IP65" / "IP 65"); fixed list, highest listed wins if a description names two.{% endcomment %}
      {%- assign ip = '' -%}{%- assign ip_text = product.description | strip_html | replace: ' ', ' ' | replace: 'IP ', 'IP' -%}{%- assign ip_codes = 'IP68,IP67,IP66,IP65,IP64,IP55,IP54,IP44,IP43,IP33,IP20' | split: ',' -%}{%- for code in ip_codes -%}{%- if ip_text contains code -%}{%- assign ip = code -%}{%- break -%}{%- endif -%}{%- endfor -%}
      {%- if ip != blank -%}{%- capture spec_rows -%}<tr><th scope="row">IP rating</th><td>{{ ip }}</td></tr>{{ spec_rows }}{%- endcapture -%}{%- endif -%}
      {% if spec_rows != blank or desc_text != blank %}{% if lead != blank or desc_text != blank %}<div class="body rte">{% if lead != blank %}<p>{{ lead }}</p>{% endif %}{% if desc_text != blank %}<p>{{ desc_text }}</p>{% endif %}</div>{% endif %}{% elsif product.description != blank %}<div class="body rte">{{ product.description }}</div>{% endif %}
      <p class="price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</p>
      {% comment %}ponytail: single variant <select>, no option-matrix JS; add when a product has 2+ options that need separate pickers{% endcomment %}
      {% form 'product', product %}
        {% if product.variants.size > 1 %}
          <label class="field"><span class="mono">Options</span><select name="id">{% for v in product.variants %}<option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}{% if v == variant %} selected{% endif %}>{{ v.title }} &mdash; {{ v.price | money }}{% unless v.available %} &mdash; sold out{% endunless %}</option>{% endfor %}</select></label>
        {% else %}
          <input type="hidden" name="id" value="{{ variant.id }}">
        {% endif %}
        <div class="buy-actions">
          <button class="btn btn-primary" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
          <a class="btn btn-ghost" href="/pages/contact">Enquire about this piece</a>
        </div>
      {% endform %}
      {% if section.settings.note_text != blank %}<div class="note"><span class="mono">{{ section.settings.note_label }}</span>{{ section.settings.note_text }}</div>{% endif %}
      {% comment %}ponytail: metafield custom.specs wins if the client ever adds one; otherwise the rows parsed from the description above. Nothing parsed → no Product Details block.{% endcomment %}
      {% if product.metafields.custom.specs != blank %}<details class="specs" open><summary>Product Details</summary>{{ product.metafields.custom.specs | metafield_tag }}</details>
      {% elsif spec_rows != blank %}<details class="specs" open><summary>Product Details</summary><table class="spec"><tbody>{{ spec_rows }}</tbody></table></details>{% endif %}
    </div>
  </div>
</div>
{%- assign rel = product.collections.first.products -%}
{%- if rel == blank or rel.size < 2 -%}{%- assign rel = collections.all.products -%}{%- endif -%}
{%- capture related_html -%}
  {%- assign n = 0 -%}
  {%- for item in rel limit: 5 -%}
    {%- if item.id == product.id or n >= 4 -%}{%- continue -%}{%- endif -%}
    {%- assign dl = n | times: 0.08 -%}
    {%- render 'product-tile', product: item, delay: dl -%}
    {%- assign n = n | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if related_html != blank -%}
<section class="related" aria-labelledby="rel-h">
  <div class="container">
    <div class="sec-head reveal"><span class="eyebrow">Related</span><h2 id="rel-h">You may also like.</h2></div>
    <div class="grid-4">{{ related_html }}</div>
  </div>
</section>
{%- endif -%}

{% style %}
.pdp>*{min-width:0}.g-thumbs{overflow-x:auto}
.g-slide-model{aspect-ratio:1/1;background:var(--paper-2);position:relative}
.g-slide-model .shopify-model-viewer-ui,.g-slide-model model-viewer{display:block;width:100%;height:100%}
[data-shopify-xr-hidden]{display:none!important}
.thumb-3d{position:relative}.thumb-3d .mono{position:absolute;right:4px;bottom:4px;font-size:10px;background:var(--paper-2);padding:0 4px}
{% endstyle %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {"type": "text", "id": "note_label", "label": "Note label"},
    {"type": "text", "id": "note_text", "label": "Note text"}
  ]
}
{% endschema %}
