<section class="hero on-dark" aria-label="Showroom">
  {%- if section.settings.image -%}
    {%- assign img = section.settings.image -%}
    <img class="hero-bg" src="{{ img | image_url: width: 1600 }}" srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w" sizes="100vw" alt="The Light + Form Concepts storefront on Balestier Road" width="{{ img.width }}" height="{{ img.height }}" fetchpriority="high">
  {%- else -%}
    <video class="hero-bg" autoplay muted loop playsinline preload="auto" poster="{{ 'hero-storefront-poster.jpg' | asset_url }}" aria-label="The Light + Form Concepts storefront on Balestier Road" width="1440" height="1080"><source src="{{ 'hero-storefront.mp4' | asset_url }}" type="video/mp4"></video>
  {%- endif -%}
  <div class="container hero-in">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="display-hero">{{ section.settings.heading }}</h1>
    <div class="hero-cta"><a class="btn btn-primary" href="{{ routes.collections_url }}">Shop the collection</a><a class="btn btn-ghost" href="/pages/contact">Visit the showroom</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Storefront photo or GIF"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Balestier Road · since 1990"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "A light for every mood, every space & every style."}
  ]
}
{% endschema %}
